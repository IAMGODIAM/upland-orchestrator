{
  "name": "ApiLog",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status_code": {
      "type": "number"
    },
    "latency_ms": {
      "type": "number"
    },
    "success": {
      "type": "boolean"
    },
    "request_payload": {
      "type": "object"
    },
    "response_payload": {
      "type": "object"
    },
    "source": {
      "type": "string",
      "enum": [
        "dashboard",
        "agent",
        "backend"
      ]
    }
  },
  "required": [
    "endpoint",
    "method",
    "status_code",
    "latency_ms",
    "success",
    "source"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}